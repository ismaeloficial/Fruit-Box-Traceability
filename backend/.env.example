# Backend configuration template. Copy to backend/.env (git-ignored) and
# replace the placeholder values. Never commit the real .env.

# PostgreSQL connection URI. On Supabase: "Connect" button > Direct connection
# (or Session pooler) > URI. The values below are fake.
SUPABASE_DB_URL=postgresql://postgres:change-me@db.your-project-ref.supabase.co:5432/postgres

# MQTT broker (local Mosquitto from docker-compose.yml)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_EVENTS=trazabilidad/eventos
